aws_region   = "ap-southeast-2"      # REPLACE — Titan Embeddings V2 is not available in ap-southeast-6
project_name = "s3-vectors-rag-demo" # REPLACE
environment  = "dev"                 # REPLACE

source_bucket_prefix = "rag-source-docs" # REPLACE
vector_bucket_name   = "rag-vectors"     # REPLACE
vector_index_name    = "rag-embeddings"  # REPLACE

embedding_model_id = "amazon.titan-embed-text-v2:0"                 # REPLACE
llm_model_id       = "au.anthropic.claude-sonnet-4-5-20250929-v1:0" # REPLACE — AU inference profile for ap-southeast-2

cognito_admin_email = "" # REPLACE — set to create an admin user at deploy time
