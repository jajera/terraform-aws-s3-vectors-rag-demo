# Copy values from: source scripts/export-env.sh  (after terraform apply)
AWS_REGION=ap-southeast-2
SOURCE_BUCKET=your-source-bucket
VECTOR_BUCKET=your-vector-bucket
VECTOR_INDEX=rag-embeddings
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
LLM_MODEL_ID=au.anthropic.claude-sonnet-4-5-20250929-v1:0
INGEST_FUNCTION_NAME=s3-vectors-rag-demo-dev-ingest
