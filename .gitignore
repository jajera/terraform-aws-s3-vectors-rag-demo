# Local .terraform directories
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files (may contain secrets)
terraform.tfvars
*.tfvars
!*.tfvars.example

# Crash log files
crash.log
crash.*.log

# Plan output files
tfplan
*.tfplan

# Sensitive key files
*.pem

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Fetched RAG corpus (reproducible via scripts/fetch-corpus.sh)
docs/corpus/*.txt
!docs/corpus/.gitkeep

# Lambda deployment artifact
.build/

# Python
__pycache__/
*.py[cod]
.venv/
